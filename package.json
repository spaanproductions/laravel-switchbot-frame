{
    "private": true,
    "name": "laravel-switchbot-frame",
    "description": "Standalone asset build (CSS + HEIC-conversion JS) for the SwitchBot AI Art Frame admin page.",
    "scripts": {
        "build": "tailwindcss -i ./resources/css/switchbot-frame.css -o ./dist/switchbot-frame.css --minify && node ./bin/build-js.mjs",
        "dev": "node ./bin/build-js.mjs && tailwindcss -i ./resources/css/switchbot-frame.css -o ./dist/switchbot-frame.css --watch"
    },
    "devDependencies": {
        "@tailwindcss/cli": "4.3.3",
        "heic2any": "^0.0.4",
        "tailwindcss": "4.3.3"
    }
}
